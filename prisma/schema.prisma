generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // url      = env("DATABASE_URL")
  url      = "mysql://vercel_user:Str0ng@Pass123@3.14.4.161:3306/daimond_shadow"
}

model field {
  id               Int                  @id @default(autoincrement())
  title            String
  slug             String               @unique(map: "Field_slug_key")
  coverImage       String
  mainDescription  String               @db.Text
  aboutTitle       String
  aboutDescription String               @db.Text
  galleryTitle     String
  createdAt        DateTime             @default(now())
  images           FieldImagesLibrary[]

  @@map("field")
}

model FieldImagesLibrary {
  id          Int     @id @default(autoincrement())
  fieldId     Int
  image       String
  title       String?
  description String? @db.Text
  field       field   @relation(fields: [fieldId], references: [id], onDelete: Cascade, map: "FieldImagesLibrary_fieldId_fkey")

  @@index([fieldId], map: "FieldImagesLibrary_fieldId_fkey")
  @@map("fieldimageslibrary")
}

model HeroSettings {
  id        Int      @id @default(1)
  title     String
  subtitle  String
  image     String   @default("/images/hero/hero-bg.jpg")
  updatedAt DateTime @default(now())

  @@map("herosettings")
}

model project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image       String
  category    String?
  createdAt   DateTime @default(now())

  @@map("project")
}

model QuoteRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  service   String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("quoterequest")
}

model service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String
  createdAt   DateTime @default(now())

  @@map("service")
}

model SocialSettings {
  id        Int      @id @default(1)
  phone     String
  whatsapp  String
  email     String
  updatedAt DateTime @default(now())

  @@map("socialsettings")
}
